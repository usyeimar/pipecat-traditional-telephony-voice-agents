# Copy to .env (git-ignored) and fill in. Read by compose.yaml and by the bot.

# Which PBX containers `docker compose up` starts: asterisk, freeswitch or both.
COMPOSE_PROFILES=asterisk,freeswitch

# --- API keys -----------------------------------------------------------------
DEEPGRAM_API_KEY=       # speech-to-text   https://console.deepgram.com
ANTHROPIC_API_KEY=      # LLM (Claude)     https://console.anthropic.com
CARTESIA_API_KEY=       # text-to-speech   https://play.cartesia.ai

# --- Shared secrets (generate each with: openssl rand -hex 32) -----------------
BOT_TOKEN=                  # PBX -> bot WebSocket credential
SIP_PASSWORD=               # softphone accounts 1000 and 1001, on both PBXs
FREESWITCH_ESL_PASSWORD=    # FreeSWITCH event socket (not needed with Asterisk only)

# --- Agent ---------------------------------------------------------------------
# AGENT_LANGUAGE=es                       # language of the call: STT and TTS
# AGENT_PROMPT_FILE=prompts/agent.md      # system prompt
# LLM_MODEL=claude-opus-5-5               # claude-haiku-5-5 answers faster and costs less
# LLM_EFFORT=low                          # low keeps answers fast; medium/high think longer
# CARTESIA_VOICE_ID=                      # pick a voice that speaks AGENT_LANGUAGE natively

# --- Network -------------------------------------------------------------------
# EXTERNAL_IP=127.0.0.1                   # LAN address of this machine, to call from other devices
# ASTERISK_SIP_PORT=5070                  # SIP port of Asterisk
# SIP_PORT=5080                           # SIP port of FreeSWITCH

# To run the bot on the host (uv run src/main.py) with the PBXs in Docker:
# ASTERISK_BOT_WS_URL=ws://host.docker.internal:8765/ws/asterisk
# BOT_WS_URL=ws://host.docker.internal:8765/ws/freeswitch
# FREESWITCH_ESL_HOST=127.0.0.1

# --- Logs ----------------------------------------------------------------------
# DEBUG (the default) prints the prompt and every transcript. Use INFO in production.
# LOGURU_LEVEL=INFO

# --- Audio tuning (defaults measured by pipecat-freeswitch on real phones) -----
# OUTPUT_GAIN_DB=-12                      # TTS is ~12 dB louder than telephone level
# VAD_MIN_VOLUME=0.4                      # phone audio is quiet; higher values miss barge-ins
# VAD_CONFIDENCE=0.7
